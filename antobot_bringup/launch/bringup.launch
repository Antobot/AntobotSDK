<launch>

	<!-- controllers -->
	<include if="true" file="$(find antobot_control)/launch/ant_controller.launch"></include>

	<!-- navigation sensors -->
	<include if="true" file="$(find antobot_navigation)/launch/antobot_sensors.launch"></include>
	
	<!-- IMU calibration -->
  	<include file="$(find antobot_heading)/launch/heading_launcher.launch"></include>
	
	<!-- robot description -->
	<include if="true" file="$(find antobot_description)/launch/param_ant_v3.launch"></include>

	<!-- Master Teleop -->	
	<include if="true" file="$(find antobot_teleop)/launch/teleop.launch"></include>

	<!-- antobot_safety -->
	<include if="true" file="$(find antobot_safety)/launch/cmd_vel_mux.launch" />
	<node if="true" pkg="antobot_safety" type="antobot_safety_node" name="antobot_safety_node" output="screen"/>

	<!-- Camera Manager -->
	<include if="true" file="$(find antobot_devices_camera)/launch/cam_manager.launch" />

	<!-- Move base (for zed camera)-->
	<include if="true" file="$(find antobot_navigation)/launch/move_base.launch" />

	<!-- AntoSupervisor -->
	<node if="true" pkg="antobot_urcu_monitor" type="softShutdown.py" name="soft_shutdown" output="log"/>
	<node if="true" pkg="antobot_robot_monitor" type="robotMonitor.py" name="robot_monitor" output="log"/>
    <node if="true" pkg="antobot_urcu_monitor" type="urcuMonitor.py" name="urcu_monitor" output="log"/>

	<!-- HMI -->
	<node if="true" pkg="antobot_hmi" type="hmi_xavier.py" name="anto_HMIbridge" output="log"/>
</launch>
